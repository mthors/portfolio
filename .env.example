# ==============================================================================
# Application Environment Configuration Template
# Copy to .env.local for local development. Never commit real secrets to Git.
# See DEPLOYMENT.md for deployment environment variable setup on Vercel / Docker.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE (PUBLIC) VARIABLES
# Variables with the NEXT_PUBLIC_ prefix are inlined into the client bundle.
# NEVER place private secrets, passwords, or confidential keys here.
# ------------------------------------------------------------------------------
# Canonical URL for SEO metadata, canonical links, and Open Graph tags.
# Production: https://thorx.my.id
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://thorx.my.id

# WhatsApp contact number in international format without '+' or symbols (e.g. 6281234567890)
# Formatted automatically into https://wa.me/<number> on the Contact section.
# If unset, defaults to placeholder 'https://wa.me/YOUR_PHONE_NUMBER'.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# 2. RUNTIME (SERVER-SIDE) VARIABLES
# Accessible only in Node.js runtime / Route Handlers. Never sent to the client.
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. CONTAINER RUNTIME VARIABLES (Docker / Standalone Server Only)
# Used by Dockerfile runner stage and local standalone Node.js server.
# Not required for managed platforms like Vercel (handled automatically).
# ------------------------------------------------------------------------------
PORT=3000
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# 4. OPTIONAL FUTURE SERVICES (Deferred to M6+ / Production)
# Configure these in your hosting dashboard secrets if implementing email delivery.
# ------------------------------------------------------------------------------
# CONTACT_EMAIL_RECIPIENT=
# CONTACT_API_KEY=

